# ~/.config/imghost/env  --  chmod 600.
#
# Read by client/screenshot-upload.sh and client/imghost-upload.sh.
# Both scripts refuse to run unless this file is mode 0600.
#
# Install:
#   mkdir -p ~/.config/imghost && chmod 700 ~/.config/imghost
#   install -m 0600 client/env.example ~/.config/imghost/env
#   $EDITOR ~/.config/imghost/env

# Where to POST. For local dev: http://127.0.0.1:8080.
BASE_URL=https://aigf.dev

# UPLOAD_TOKEN value from /etc/imghost.env on the host (the app-layer
# Bearer token, validated by axum after Cloudflare Access lets the request
# through).
TOKEN=replace-me-with-the-server-side-UPLOAD_TOKEN

# Cloudflare Access service token credentials for the `imghost-uploader`
# token (Zero Trust → Access → Service Auth → Service Tokens).
# These are NOT the same as the deploy service token.
CF_ACCESS_CLIENT_ID=replace-me.access
CF_ACCESS_CLIENT_SECRET=replace-me-with-the-client-secret
