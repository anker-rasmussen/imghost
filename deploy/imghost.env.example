# /etc/imghost.env  --  chmod 600, owner root.
#
#   sudo install -m 0600 -o root -g root deploy/imghost.env.example /etc/imghost.env
#   sudo $EDITOR /etc/imghost.env
#
# Generate strong secrets:
#   UPLOAD_TOKEN:  openssl rand -base64 48
#   ADMIN_PASS:    openssl rand -base64 32

# Required ---------------------------------------------------------------
UPLOAD_TOKEN=replace-me-with-openssl-rand-base64-48
ADMIN_PASS=replace-me-with-openssl-rand-base64-32
PUBLIC_BASE_URL=https://aigf.dev

# Optional ---------------------------------------------------------------
ADMIN_USER=admin
MAX_UPLOAD_BYTES=26214400
RUST_LOG=imghost=info,tower_http=info
